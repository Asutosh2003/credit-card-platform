PORT=4000
HOST=0.0.0.0

# Use your own PostgreSQL database. Never commit a real connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Replace with a long, random value and keep it private.
JWT_SECRET=replace-with-a-long-random-secret

# Set these before creating an admin or seeding demo users.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-admin-password
SEED_DEMO_PASSWORD=replace-with-a-unique-demo-password
PROVISION_DEFAULT_PASSWORD=replace-with-a-unique-provisioning-password

# Optional: location for the persistent bearer token file.
# API_BEARER_TOKEN_FILE=C:\path\outside\the\app\api-bearer-token

# Optional public URL for clients / IdentitySphere connector.
# API_BASE_URL=http://localhost:4000

# Optional comma-separated browser origins. Leave unset for local Vite origins.
# CORS_ORIGINS=http://localhost:5173

# How many demo users to seed (default 100; maximum 100).
# SEED_USER_COUNT=100
