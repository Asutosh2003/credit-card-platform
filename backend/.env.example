PORT=4000
HOST=0.0.0.0

# Use your own PostgreSQL database. Never commit a real connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Replace with a long, random value and keep it private.
JWT_SECRET=replace-with-a-long-random-secret

# Set these before creating an admin or seeding demo users.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-admin-password
SEED_DEMO_PASSWORD=replace-with-a-unique-demo-password
PROVISION_DEFAULT_PASSWORD=replace-with-a-unique-provisioning-password

# Required for IdentitySphere (same pattern as Wisbility HRMS).
# Static bearer — set once in .env, paste into App Registry Bearer token field.
# Do not use session JWTs or regenerating API keys for the connector.
API_BEARER_TOKEN=dev-local-bearer-token

# Performance (remote Supabase): cache connector auth; bcrypt rounds for joiners.
# AUTH_CACHE_TTL_MS=60000
# PROVISION_BCRYPT_ROUNDS=4
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_MS=60000

# For lightning-fast local demos, point DATABASE_URL at a local Postgres instead
# of a remote Supabase region (each round-trip to ap-northeast-2 is ~130–200ms).

# Optional public URL for clients / IdentitySphere connector.
# API_BASE_URL=http://localhost:4000

# Optional comma-separated browser origins. Leave unset for local Vite origins.
# CORS_ORIGINS=http://localhost:5173

# How many demo users to seed (default 100; maximum 100).
# SEED_USER_COUNT=100
